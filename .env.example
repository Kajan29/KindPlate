# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google Maps
# Enable "Maps SDK for Android" (and "Maps SDK for iOS") in Google Cloud Console,
# then create an API key: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
